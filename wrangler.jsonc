{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thekaxro",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*" ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thekaxro-db",
      "database_id": "8a251e00-a961-4883-9432-427b73544aa2",
      "migrations_dir": "migrations"
    }
  ]
}
